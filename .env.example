# =============================================
# LearnSphere Environment Configuration
# =============================================
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.

# ---- Server ----
NODE_ENV=development
SERVER_PORT=3001

# ---- Client ----
# The URL where the client dev server runs
CLIENT_URL=http://localhost:5173

# ---- Database ----
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/learnsphere

# ---- JWT ----
# Generate strong random secrets (e.g.: openssl rand -base64 64)
JWT_ACCESS_SECRET=replace_with_strong_random_secret_min_64_chars
JWT_REFRESH_SECRET=replace_with_another_strong_random_secret_min_64_chars

# Access token expiry (e.g. 15m, 1h)
JWT_ACCESS_EXPIRES_IN=15m

# Refresh token expiry in days (stored as cookie maxAge)
REFRESH_TOKEN_EXPIRES_DAYS=7

# ---- Storage ----
# Absolute or relative path to local storage directory
STORAGE_ROOT=./storage

# Upload size limits (in bytes)
MAX_IMAGE_SIZE=5242880
MAX_DOCUMENT_SIZE=20971520
MAX_VIDEO_SIZE=104857600

# ---- Rate Limiting ----
# Auth endpoint rate limit (requests per window)
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000

# ---- CORS ----
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173
